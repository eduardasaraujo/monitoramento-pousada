# Copie este arquivo para config/.env e preencha com os dados do DVR.
# O arquivo .env NUNCA deve ser enviado ao repositório (já está no .gitignore).

# Endereço do DVR Intelbras MHDX1108 na rede local da pousada
DVR_IP=192.168.1.100
DVR_PORTA=554

# Crie no DVR um usuário só de visualização para o sistema (não use o admin)
DVR_USUARIO=usuario_monitoramento
DVR_SENHA=troque_esta_senha

# Canal da câmera no DVR (1 a 8)
DVR_CANAL=1

# 0 = fluxo principal (alta resolução), 1 = substream (baixa resolução, recomendado)
DVR_SUBTIPO=1
